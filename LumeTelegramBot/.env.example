# Get this from @BotFather on Telegram: /newbot -> follow the prompts -> paste the token here
BOT_TOKEN=

# Your own Telegram numeric user id — DMs to this id get the "confirm/reject payment" buttons.
# Don't know it? Start the bot with a blank ADMIN_CHAT_ID, message it /id, it'll reply with your id.
ADMIN_CHAT_ID=

# Where LumeKeyServer is running. Local for now; swap to the Railway URL once deployed.
KEY_SERVER_URL=http://localhost:3000
# Must match LumeKeyServer's ADMIN_TOKEN (see LumeKeyServer/.env)
KEY_SERVER_ADMIN_TOKEN=change-me-to-a-long-random-secret

# Shown on the "buy" screen. Plain text, can include a card number / crypto address / @username to pay.
PAYMENT_INSTRUCTIONS=Напишите @your_admin_username для реквизитов оплаты.
PRICE_LABEL=— (сообщи цену в PRICE_LABEL в .env)
